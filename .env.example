# Copy to .env and fill in real values. Never commit the actual .env file.
JWT_SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Only set to true if this app is deployed behind a trusted reverse proxy
# that itself sets/overwrites X-Forwarded-For (never forwarding a raw
# client-supplied value). Leave false/unset for direct-to-client deployments
# (the default here) - otherwise rate limiting becomes spoofable.
RATE_LIMIT_TRUST_X_FORWARDED_FOR=false
