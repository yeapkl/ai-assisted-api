# Copy to .env and fill in real values. Never commit the actual .env file.
JWT_SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Only set to true if this app is deployed behind a trusted reverse proxy
# that itself sets/overwrites X-Forwarded-For (never forwarding a raw
# client-supplied value). Leave false/unset for direct-to-client deployments
# (the default here) - otherwise rate limiting becomes spoofable.
RATE_LIMIT_TRUST_X_FORWARDED_FOR=false

# --- OAuth 2.1 Authorization Server (additive) ---
# Fail-fast secrets, same posture as JWT_SECRET_KEY above: required, never
# committed, at least 32 characters. See com.apitest.oauth.OAuthProperties.
OAUTH_SIGNING_KEY_SECRET=changeme-generate-with-openssl-rand-hex-32
MCP_OAUTH_CLIENT_SECRET=changeme-generate-with-openssl-rand-hex-32
# This service's own issuer identifier - must match how it's reached.
OAUTH_ISSUER=http://localhost:8000
# The single pre-registered OAuth client (mcp-server) - see
# docs/requirements/hello-world-api.md §4.
MCP_OAUTH_CLIENT_ID=mcp-server
MCP_OAUTH_REDIRECT_URIS=http://127.0.0.1:8765/callback
MCP_OAUTH_RESOURCE_AUDIENCE=mcp-server
# This app's own resource identifier - the specific audience value required
# on an OAuth token to call this app's own GET /api/v1/hello. This is
# ALWAYS additionally stamped onto every issued token, on top of
# MCP_OAUTH_RESOURCE_AUDIENCE above, regardless of that value (QA-flagged
# gap fix, 2026-09-21) - since the single mcp-server client's token is used
# both to call mcp-server's own tools AND (via get_hello_greeting's
# call-through) this app's own endpoint with the same token. See
# com.apitest.oauth.OAuthProperties#getSelfAudience().
OAUTH_SELF_AUDIENCE=hello-world-api
